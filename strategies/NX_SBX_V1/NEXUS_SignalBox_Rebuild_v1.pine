//@version=6
// NEXUS SignalBox Rebuild v1 — open reconstruction of the "Buy/Sell AI + ICT" reel indicator
// STATED in video : auto Entry / TP1 / TP2 / Stop box, ICT concepts, stop -> breakeven after TP1,
//                   target = opposing (bullish) fair value gap, shorts during NY open.
// MEASURED on chart: stop = 1R, TP1 = 1R, TP2 = 2R (37.25 / 37.25 / 74.50 pts), 1 NQ, signal ~9:49 ET.
// INFERRED (vendor withholds): trigger = liquidity sweep of swing -> displacement candle ->
//                   MSS or FVG, filtered by HMA trend flip. Stop = beyond sweep extreme, ATR floor.
// Honest stats: breakeven exits are NOT wins. Gate: PF >= 1.3, >= 40 positions, final third OOS.
strategy("NEXUS SignalBox Rebuild v1", shorttitle="NX-SBX v1", overlay=true,
     initial_capital=50000, currency=currency.USD,
     default_qty_type=strategy.fixed, default_qty_value=2, pyramiding=0,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.75,
     slippage=1, calc_on_every_tick=false, process_orders_on_close=false,
     max_labels_count=500)

// ───────── Inputs ─────────
grpD = "Direction & Session"
dirMode   = input.string("Both", "Direction", options=["Both", "Long Only", "Short Only"], group=grpD)
qty       = input.int(2, "Contracts (min 2 for TP1 partial)", minval=2, maxval=3, group=grpD)
winSess   = input.session("0830-1445", "Entry window (CT)", group=grpD)
flatHHMM  = input.int(1455, "Flatten at bar start HHMM (CT)", minval=0, maxval=2359, group=grpD)
maxTrades = input.int(3, "Max entries per day", minval=1, group=grpD)
dailyLoss = input.float(1000.0, "Max intraday loss ($)", minval=1, group=grpD)

grpS = "Signal"
hmaLen   = input.int(21, "Trend HMA length", minval=2, group=grpS)
swingLen = input.int(3, "Swing pivot strength", minval=1, group=grpS)
sweepWin = input.int(6, "Sweep to trigger window (bars)", minval=1, group=grpS)
atrLen   = input.int(14, "ATR length", minval=1, group=grpS)
dispMult = input.float(0.8, "Displacement body >= ATR x", minval=0.1, step=0.1, group=grpS)
needMss  = input.bool(false, "Require MSS (off = MSS or FVG)", group=grpS)

grpR = "Risk & Exits"
bufTicks  = input.int(4, "Stop buffer beyond sweep (ticks)", minval=0, group=grpR)
atrFloor  = input.float(1.0, "Minimum stop = ATR x", minval=0.1, step=0.1, group=grpR)
maxStopPt = input.float(60.0, "Skip signal if stop > points", minval=1, group=grpR)
tp1R      = input.float(1.0, "TP1 (R)", minval=0.1, step=0.1, group=grpR)
tp2R      = input.float(2.0, "TP2 (R)", minval=0.2, step=0.1, group=grpR)
beTicks   = input.int(1, "Breakeven offset after TP1 (ticks)", minval=0, group=grpR)
useFvgTP  = input.bool(true, "TP2 = opposing FVG edge when beyond TP1", group=grpR)
oppExit   = input.bool(false, "Exit on opposite signal", group=grpR)

grpT = "Validation Panel"
beTolUsd = input.float(10.0, "Breakeven tolerance ($)", minval=0, group=grpT)
gatePF   = input.float(1.3, "Gate profit factor", minval=0, group=grpT)
gateN    = input.int(40, "Gate minimum positions", minval=1, group=grpT)

strategy.risk.max_intraday_loss(dailyLoss, strategy.cash)

// ───────── Core series ─────────
tz       = "America/Chicago"
tick     = syminfo.mintick
atr      = ta.atr(atrLen)
hma      = ta.hma(close, hmaLen)
trendUp  = hma > hma[1]
trendDn  = hma < hma[1]
inWindow = not na(time(timeframe.period, winSess, tz))
hhmm     = hour(time, tz) * 100 + minute(time, tz)
newDay   = dayofmonth(time, tz) != dayofmonth(time[1], tz)

f_rt(float p) => math.round_to_mintick(p)

var int tradesToday = 0
if newDay
    tradesToday := 0

// ───────── Liquidity sweep tracking ─────────
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float shLvl = na
var float shExt = na
var int   shBar = na
var float slLvl = na
var float slExt = na
var int   slBar = na

if not na(ph)
    shLvl := ph
    shBar := na
    shExt := na
if not na(pl)
    slLvl := pl
    slBar := na
    slExt := na

if not na(shLvl) and na(shBar) and high > shLvl
    shBar := bar_index
    shExt := high
else if not na(shBar)
    shExt := math.max(shExt, high)

if not na(slLvl) and na(slBar) and low < slLvl
    slBar := bar_index
    slExt := low
else if not na(slBar)
    slExt := math.min(slExt, low)

sweptHigh = not na(shBar) and bar_index - shBar <= sweepWin and close < shLvl
sweptLow  = not na(slBar) and bar_index - slBar <= sweepWin and close > slLvl

// ───────── Displacement / structure ─────────
body     = math.abs(close - open)
dispDn   = close < open and body >= dispMult * atr
dispUp   = close > open and body >= dispMult * atr
bearFvg  = high < low[2]
bullFvg  = low > high[2]
mssDn    = not na(slLvl) and close < slLvl
mssUp    = not na(shLvl) and close > shLvl
structDn = needMss ? mssDn : (mssDn or bearFvg)
structUp = needMss ? mssUp : (mssUp or bullFvg)

// ───────── Opposing FVG targets ─────────
var float bullTop = na
var float bullBot = na
var float bearBot = na
var float bearTop = na
if bullFvg
    bullTop := low
    bullBot := high[2]
if bearFvg
    bearBot := high
    bearTop := low[2]
if not na(bullBot) and low <= bullBot
    bullTop := na
    bullBot := na
if not na(bearTop) and high >= bearTop
    bearBot := na
    bearTop := na

// ───────── Signals ─────────
allowLong  = dirMode != "Short Only"
allowShort = dirMode != "Long Only"
flat       = strategy.position_size == 0

sStop = math.max(nz(shExt, high) + bufTicks * tick, close + atrFloor * atr)
sRisk = sStop - close
lStop = math.min(nz(slExt, low) - bufTicks * tick, close - atrFloor * atr)
lRisk = close - lStop

rawShort = sweptHigh and dispDn and structDn and trendDn
rawLong  = sweptLow and dispUp and structUp and trendUp
canTrade = inWindow and hhmm < flatHHMM and tradesToday < maxTrades and barstate.isconfirmed

shortSig = allowShort and rawShort and canTrade and flat and sRisk <= maxStopPt
longSig  = allowLong and rawLong and canTrade and flat and lRisk <= maxStopPt and not shortSig

// ───────── Trade state ─────────
var float tRisk   = na
var float tFvgTP  = na
var int   tDir    = 0
var bool  tp1Done = false

if flat and not shortSig and not longSig
    tp1Done := false

if shortSig
    tRisk   := sRisk
    tDir    := -1
    tp1Done := false
    tFvgTP  := useFvgTP and not na(bullTop) and bullTop < close - tp1R * sRisk ? bullTop : na
    strategy.entry("Short", strategy.short, qty=qty, comment="Sell!")
    tradesToday += 1
    shBar := na
    shLvl := na

if longSig
    tRisk   := lRisk
    tDir    := 1
    tp1Done := false
    tFvgTP  := useFvgTP and not na(bearBot) and bearBot > close + tp1R * lRisk ? bearBot : na
    strategy.entry("Long", strategy.long, qty=qty, comment="Buy!")
    tradesToday += 1
    slBar := na
    slLvl := na

// ───────── Exit management: SL = 1R, TP1 = 1R (50%), then stop -> BE, TP2 = 2R or FVG ─────────
if strategy.position_size != 0 or shortSig or longSig
    inPos = strategy.position_size != 0
    dir   = inPos ? int(math.sign(strategy.position_size)) : tDir
    base  = inPos ? strategy.position_avg_price : close
    if inPos and math.abs(strategy.position_size) < qty
        tp1Done := true
    stopInit = base - dir * tRisk
    tp1      = base + dir * tp1R * tRisk
    tp2      = not na(tFvgTP) ? tFvgTP : base + dir * tp2R * tRisk
    beStop   = base + dir * beTicks * tick
    eid      = dir > 0 ? "Long" : "Short"
    if not tp1Done
        strategy.exit(eid + " TP1", eid, qty_percent=50, limit=f_rt(tp1), stop=f_rt(stopInit), comment_profit="TP1", comment_loss="SL")
        strategy.exit(eid + " TP2", eid, limit=f_rt(tp2), stop=f_rt(stopInit), comment_profit="TP2", comment_loss="SL")
    else
        strategy.exit(eid + " TP2", eid, limit=f_rt(tp2), stop=f_rt(beStop), comment_profit="TP2", comment_loss="BE")

if oppExit and ((strategy.position_size < 0 and rawLong) or (strategy.position_size > 0 and rawShort))
    strategy.close_all(comment="Opp")

if strategy.position_size != 0 and hhmm >= flatHHMM
    strategy.close_all(comment="EOD", immediately=true)

// ───────── Visuals ─────────
plotshape(shortSig, title="Sell", style=shape.triangledown, location=location.abovebar, color=color.red, text="Sell!", textcolor=color.red, size=size.small)
plotshape(longSig, title="Buy", style=shape.triangleup, location=location.belowbar, color=color.green, text="Buy!", textcolor=color.green, size=size.small)
plot(hma, "Trend HMA", color=trendUp ? color.teal : color.red, linewidth=2)

posOpen = strategy.position_size != 0
pDir    = math.sign(strategy.position_size)
pAvg    = strategy.position_avg_price
plot(posOpen ? pAvg : na, "Entry", color=color.blue, style=plot.style_linebr)
plot(posOpen ? (tp1Done ? pAvg + pDir * beTicks * tick : pAvg - pDir * tRisk) : na, "Stop", color=color.red, style=plot.style_linebr)
plot(posOpen ? pAvg + pDir * tp1R * tRisk : na, "TP1", color=color.green, style=plot.style_linebr)
plot(posOpen ? (not na(tFvgTP) ? tFvgTP : pAvg + pDir * tp2R * tRisk) : na, "TP2", color=color.lime, style=plot.style_linebr)

// ───────── Validation panel (positions, not partial fills; BE is not a win) ─────────
var table tbl = table.new(position.top_right, 4, 9, bgcolor=color.new(color.black, 15), border_width=1, frame_color=color.gray)

fin(array<float> arr, float pnl, float tol) =>
    array.set(arr, 0, array.get(arr, 0) + math.max(pnl, 0))
    array.set(arr, 1, array.get(arr, 1) + math.max(-pnl, 0))
    array.set(arr, 2, array.get(arr, 2) + 1)
    if pnl > tol
        array.set(arr, 3, array.get(arr, 3) + 1)
    else if pnl < -tol
        array.set(arr, 4, array.get(arr, 4) + 1)
    else
        array.set(arr, 5, array.get(arr, 5) + 1)
    true

pfOf(array<float> a) =>
    array.get(a, 1) > 0 ? array.get(a, 0) / array.get(a, 1) : na

wrOf(array<float> a) =>
    array.get(a, 2) > 0 ? 100 * array.get(a, 3) / array.get(a, 2) : na

fmtv(float v, string f) =>
    na(v) ? "—" : str.tostring(v, f)

putRow(int r, string lbl, string a, string b, string c) =>
    table.cell(tbl, 0, r, lbl, text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, r, a, text_color=color.white, text_size=size.small)
    table.cell(tbl, 2, r, b, text_color=color.white, text_size=size.small)
    table.cell(tbl, 3, r, c, text_color=color.white, text_size=size.small)

if barstate.islastconfirmedhistory or barstate.islast
    ct = strategy.closedtrades
    int posTotal = 0
    int prevB = -1
    if ct > 0
        for i = 0 to ct - 1
            b = strategy.closedtrades.entry_bar_index(i)
            if b != prevB
                posTotal += 1
                prevB := b
    isCount = posTotal - int(math.floor(posTotal / 3.0))

    isA  = array.new_float(6, 0.0)
    oosA = array.new_float(6, 0.0)
    allA = array.new_float(6, 0.0)
    int k = -1
    float pnl = 0.0
    prevB := -1
    if ct > 0
        for i = 0 to ct - 1
            b = strategy.closedtrades.entry_bar_index(i)
            if b != prevB
                if k >= 0
                    fin(k < isCount ? isA : oosA, pnl, beTolUsd)
                    fin(allA, pnl, beTolUsd)
                k += 1
                pnl := 0.0
                prevB := b
            pnl += strategy.closedtrades.profit(i)
        fin(k < isCount ? isA : oosA, pnl, beTolUsd)
        fin(allA, pnl, beTolUsd)

    putRow(0, "NX-SBX v1", "IS", "OOS", "ALL")
    putRow(1, "Positions", fmtv(array.get(isA, 2), "#"), fmtv(array.get(oosA, 2), "#"), fmtv(array.get(allA, 2), "#"))
    putRow(2, "Wins", fmtv(array.get(isA, 3), "#"), fmtv(array.get(oosA, 3), "#"), fmtv(array.get(allA, 3), "#"))
    putRow(3, "Losses", fmtv(array.get(isA, 4), "#"), fmtv(array.get(oosA, 4), "#"), fmtv(array.get(allA, 4), "#"))
    putRow(4, "Breakeven", fmtv(array.get(isA, 5), "#"), fmtv(array.get(oosA, 5), "#"), fmtv(array.get(allA, 5), "#"))
    putRow(5, "Win %", fmtv(wrOf(isA), "#.0"), fmtv(wrOf(oosA), "#.0"), fmtv(wrOf(allA), "#.0"))
    putRow(6, "Net $", fmtv(array.get(isA, 0) - array.get(isA, 1), "#.00"), fmtv(array.get(oosA, 0) - array.get(oosA, 1), "#.00"), fmtv(array.get(allA, 0) - array.get(allA, 1), "#.00"))
    putRow(7, "Profit Factor", fmtv(pfOf(isA), "#.00"), fmtv(pfOf(oosA), "#.00"), fmtv(pfOf(allA), "#.00"))

    gatePass = nz(pfOf(allA), 0) >= gatePF and array.get(allA, 2) >= gateN and nz(pfOf(oosA), 0) >= gatePF
    table.cell(tbl, 0, 8, "GATE", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    gateTxt = gatePass ? "PASS" : "FAIL"
    gateBg  = gatePass ? color.new(color.green, 20) : color.new(color.red, 20)
    table.cell(tbl, 1, 8, gateTxt, text_color=color.white, bgcolor=gateBg, text_size=size.small)
    table.cell(tbl, 2, 8, "PF≥" + str.tostring(gatePF), text_color=color.white, text_size=size.small)
    table.cell(tbl, 3, 8, "N≥" + str.tostring(gateN), text_color=color.white, text_size=size.small)
