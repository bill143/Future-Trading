# ── Webhook ───────────────────────────────────────────────────────────────────
# A random, hard-to-guess string used to authenticate TradingView alert payloads.
WEBHOOK_SECRET=your-random-secret-here

# ── Tradovate ─────────────────────────────────────────────────────────────────
# The email address you use to log in to Tradovate.
TRADOVATE_USERNAME=your@email.com

# Your Tradovate account password.
TRADOVATE_PASSWORD=yourpassword

# The App Name you registered in the Tradovate Developer Portal.
TRADOVATE_APP_ID=YourAppName

# The version string for your registered application (e.g. "1.0").
TRADOVATE_APP_VERSION=1.0

# Client ID (numeric) assigned to your app in the Tradovate Developer Portal.
TRADOVATE_CID=12345

# Client secret assigned to your app in the Tradovate Developer Portal.
TRADOVATE_SEC=your-client-secret

# The numeric account ID shown in the Tradovate UI or returned by GET /account/list.
TRADOVATE_ACCOUNT_ID=123456

# Set to "true" to target the Tradovate demo environment instead of live.
# Always use "true" while testing to avoid real trades.
TRADOVATE_DEMO=true

# ── Schwab ────────────────────────────────────────────────────────────────────
# The App Key (Client ID) from your app in the Schwab Developer Portal.
SCHWAB_CLIENT_ID=your-schwab-app-key

# The App Secret (Client Secret) from your app in the Schwab Developer Portal.
SCHWAB_CLIENT_SECRET=your-schwab-secret

# A long-lived OAuth2 refresh token obtained after the initial authorization flow.
# See server/README.md for instructions on how to generate this token.
SCHWAB_REFRESH_TOKEN=your-long-lived-refresh-token

# The encrypted account ID (account hash) returned by GET /trader/v1/accounts.
# Do NOT use the plain account number — Schwab requires the hashed value.
SCHWAB_ACCOUNT_HASH=your-encrypted-account-id

# ── Durable store (REQUIRED) ──────────────────────────────────────────────────
# Kill-switch state, trade log, idempotency keys and risk counters live here.
# Vercel serverless functions are stateless — without a durable store the kill
# switch cannot work, and the endpoint refuses every order rather than trade
# with an unknown safety state.
#
# Create a free Redis database at https://console.upstash.com, then copy the
# REST URL and REST TOKEN from its "REST API" tab.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# Local development ONLY. Substitutes a non-durable in-process map so tests can
# run without Redis. Never set this in Vercel — it would silently reintroduce
# the exact serverless bug this store was built to fix.
# ALLOW_MEMORY_STORE=true

# ── Risk engine ───────────────────────────────────────────────────────────────
# Every limit fails closed: if it cannot be evaluated, the order is rejected.

# Maximum contracts in a single order.
RISK_MAX_QTY_PER_ORDER=3

# Maximum net contracts open across all orders for one product.
RISK_MAX_OPEN_CONTRACTS=3

# Maximum orders accepted per trading day.
RISK_MAX_ORDERS_PER_DAY=40

# Block full-size ES/NQ/RTY/YM/GC. Leave false while on a combine — one
# full-size NQ is 10x a MNQ and will breach a micro-sized drawdown limit.
RISK_ALLOW_FULL_SIZE=false

# Session window, Central time. Entries outside it are refused; "close" is
# always permitted so a position can be flattened at any hour.
RISK_SESSION_START=08:30
RISK_SESSION_END=15:00
RISK_FLAT_BY=15:55
RISK_ENFORCE_SESSION=true

# ── Contract resolution ───────────────────────────────────────────────────────
# Front-month contracts are computed from the current date. Override any product
# by hand during roll week, e.g. CONTRACT_MNQ=MNQZ6
# CONTRACT_MNQ=

# Tradovate contract year digits. 1 -> "MNQZ6", 2 -> "MNQZ26".
CONTRACT_YEAR_DIGITS=1
