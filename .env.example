# ── Webhook ───────────────────────────────────────────────────────────────────
# A random, hard-to-guess string used to authenticate TradingView alert payloads.
WEBHOOK_SECRET=your-random-secret-here

# ── Tradovate ─────────────────────────────────────────────────────────────────
# The email address you use to log in to Tradovate.
TRADOVATE_USERNAME=your@email.com

# Your Tradovate account password.
TRADOVATE_PASSWORD=yourpassword

# The App Name you registered in the Tradovate Developer Portal.
TRADOVATE_APP_ID=YourAppName

# The version string for your registered application (e.g. "1.0").
TRADOVATE_APP_VERSION=1.0

# Client ID (numeric) assigned to your app in the Tradovate Developer Portal.
TRADOVATE_CID=12345

# Client secret assigned to your app in the Tradovate Developer Portal.
TRADOVATE_SEC=your-client-secret

# The numeric account ID shown in the Tradovate UI or returned by GET /account/list.
TRADOVATE_ACCOUNT_ID=123456

# Set to "true" to target the Tradovate demo environment instead of live.
# Always use "true" while testing to avoid real trades.
TRADOVATE_DEMO=true

# ── Schwab ────────────────────────────────────────────────────────────────────
# The App Key (Client ID) from your app in the Schwab Developer Portal.
SCHWAB_CLIENT_ID=your-schwab-app-key

# The App Secret (Client Secret) from your app in the Schwab Developer Portal.
SCHWAB_CLIENT_SECRET=your-schwab-secret

# A long-lived OAuth2 refresh token obtained after the initial authorization flow.
# See server/README.md for instructions on how to generate this token.
SCHWAB_REFRESH_TOKEN=your-long-lived-refresh-token

# The encrypted account ID (account hash) returned by GET /trader/v1/accounts.
# Do NOT use the plain account number — Schwab requires the hashed value.
SCHWAB_ACCOUNT_HASH=your-encrypted-account-id

# ── Analysis Layer (LangChain Multi-Agent) ────────────────────────────────────
# Set to "false" to disable the /api/analyze endpoint entirely.
ANALYSIS_ENABLED=true

# LLM provider: openai | anthropic | groq
LLM_PROVIDER=openai

# LLM model name (e.g. gpt-4o-mini, claude-3-haiku-20240307, llama3-8b-8192)
LLM_MODEL=gpt-4o-mini

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Anthropic API key (set LLM_PROVIDER=anthropic to use)
# ANTHROPIC_API_KEY=sk-ant-...

# Groq API key (set LLM_PROVIDER=groq to use)
# GROQ_API_KEY=gsk_...

# Alpha Vantage – technical indicators & news sentiment
# Free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# FRED – macroeconomic data (Federal Reserve Bank of St. Louis)
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Timeout for the Python analysis subprocess (milliseconds, default 120000)
ANALYSIS_TIMEOUT_MS=120000

# Minimum confidence score (0.0–1.0) required to auto-forward a signal to /api/webhook
AUTO_TRADE_MIN_CONFIDENCE=0.65
