# ── LLM Provider ──────────────────────────────────────────────────────────
# Supported: openai, anthropic, groq
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Anthropic (optional – set LLM_PROVIDER=anthropic to use)
# ANTHROPIC_API_KEY=sk-ant-...

# Groq (optional – set LLM_PROVIDER=groq to use)
# GROQ_API_KEY=gsk_...

# ── Market Data ────────────────────────────────────────────────────────────
# Alpha Vantage – technical data & news sentiment
# Free tier: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# FRED – macroeconomic data (Federal Reserve of St. Louis)
# Free: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── Analysis Layer Toggle ─────────────────────────────────────────────────
# Set to "false" to disable the /api/analyze endpoint entirely
ANALYSIS_ENABLED=true

# Timeout for the Python analysis subprocess (milliseconds)
ANALYSIS_TIMEOUT_MS=120000

# Minimum confidence (0-1) required to auto-forward signal to /api/webhook
AUTO_TRADE_MIN_CONFIDENCE=0.65
